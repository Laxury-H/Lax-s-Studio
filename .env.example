# NVIDIA NIM API. Used for AI chat/reviews through an OpenAI-compatible endpoint.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
NVIDIA_CHAT_MODEL=""
NVIDIA_PREDICTION_MODEL=""
NVIDIA_PORTFOLIO_MODEL=""
NVIDIA_MACRO_MODEL=""
NVIDIA_NEWS_MODEL=""
NVIDIA_PROFILE_MODEL=""
NVIDIA_ROUTER_MODEL=""
AI_REQUEST_TIMEOUT_MS="60000"
AI_CACHE_TTL_MS="300000"
AI_CACHE_MAX_ENTRIES="200"
AI_PREDICTION_CACHE_TTL_MS="90000"
AI_PORTFOLIO_CACHE_TTL_MS="60000"
AI_MACRO_CACHE_TTL_MS="300000"
AI_NEWS_CACHE_TTL_MS="600000"
AI_SENTIMENT_CACHE_TTL_MS="3600000"
AI_ASSET_PROFILE_CACHE_TTL_MS="21600000"
AI_SEARCH_INTENT_CACHE_TTL_MS="60000"

# Local account session lifetime in milliseconds. Default: 7 days.
AUTH_SESSION_TTL_MS="604800000"
# Enables passwordless local workspace login. Default: true outside production, false in production unless set true.
AUTH_LOCAL_WORKSPACE_ENABLED="true"
AUTH_LOCAL_WORKSPACE_EMAIL="workspace@laxs.local"

# Optional stock quote providers. Keep these server-side only.
# Finnhub is preferred when both keys are present because its quote endpoint is compact.
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Optional CoinGecko Demo API key for crypto quotes.
# If empty, the app uses CoinGecko's keyless public endpoint with lower reliability.
COINGECKO_API_KEY=""

# Market data cache/poll guardrails in milliseconds.
MARKET_DB_PATH="data/finpilot-market.sqlite"
MARKET_VISIBLE_CATEGORIES="US,Crypto,ETFs"
MARKET_CACHE_TTL_MS="60000"
MARKET_REQUEST_TIMEOUT_MS="8000"
MARKET_REFRESH_INTERVAL_MS="60000"
MARKET_STALE_AFTER_MS="180000"
MARKET_FORCE_REFRESH_MIN_INTERVAL_MS="15000"
MARKET_STOCK_FETCH_LIMIT="15"
MARKET_STOCK_FETCH_CONCURRENCY="3"
MARKET_STOCK_FETCH_CHUNK_DELAY_MS="750"
MARKET_PROVIDER_FAILURE_THRESHOLD="3"
MARKET_PROVIDER_COOLDOWN_MS="120000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Search integration via Tavily (for news/live data)
TAVILY_API_KEY=""
